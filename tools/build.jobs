# What build.bat builds, a job a line, for tools\run_jobs.py (its head says how a line reads). The order is the one the
# jobs ran in one after another, and the one their output is printed in. build.bat sets IMGUI_OBJ and SOUNDS and makes
# the folders. No two jobs write the same file: each names its own .obj, and what a link leaves beside its file has the
# file's name. /MP only lets one cl call compile its own sources side by side.

# the mod: Dear ImGui (deps\imgui, 1.92.1) and its DirectX 11 renderer (src\ng_dx11.cpp) compiled in; ng_overlay.cpp
# is Next Gen's overlay (the Present hook, the NEXT GEN menu), gauge_overlay.cpp draws the cluster and the Gameplay
# tab with it, its text in the game's font through stb_truetype (deps\stb); gauges.cpp is the mod's thread
imgui :: cl /nologo /c /MP /O2 /W3 /EHsc /std:c++17 /utf-8 /MT /I deps\imgui /I deps\stb /Fo:out\obj\ deps\imgui\imgui.cpp deps\imgui\imgui_draw.cpp deps\imgui\imgui_tables.cpp deps\imgui\imgui_widgets.cpp src\ng_dx11.cpp
overlay :: cl /nologo /c /MP /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I deps\imgui /I deps\stb /Fo:out\obj\ src\ng_overlay.cpp src\gauge_overlay.cpp
reshade :: cl /nologo /c /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I deps\reshade\include /Fo:out\obj\ng_reshade.obj src\ng_reshade.cpp

# the game's gearbox functions hooked (src\gearbox_hooks.cpp) through Microsoft Detours (src\detours, MIT, built from
# its source with the static CRT; its own warnings are not ours), in one library the mod and the tests link. It
# must be built /O2: the hook on the game's truck update relies on its call through being a tail jump (review 10, D2)
detours :: cl /nologo /c /MP /O2 /w /MT /DWIN32_LEAN_AND_MEAN /D_WIN32_WINNT=0x0601 /Fo:out\obj\detours\ src\detours\detours.cpp src\detours\disasm.cpp src\detours\modules.cpp src\detours\creatwth.cpp src\detours\image.cpp
gearbox_hooks :: cl /nologo /c /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /Fo:out\obj\gearbox_hooks.obj src\gearbox_hooks.cpp
gearbox_lib needs=detours,gearbox_hooks :: lib /nologo /OUT:out\obj\gearbox.lib out\obj\gearbox_hooks.obj out\obj\detours\detours.obj out\obj\detours\disasm.obj out\obj\detours\modules.obj out\obj\detours\creatwth.obj out\obj\detours\image.obj

# the recordings the mod's file carries (src\sounds.rc: assets\turbo_high_1.wav and eight more). Without them the
# mod is built all the same and makes its sounds by code (src\sound.h)
sounds :: if exist assets\turbo_high_1.wav rc /nologo /fo out\obj\sounds.res src\sounds.rc
input_devices :: cl /nologo /c /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /Fo:out\obj\input_devices.obj src\input_devices.cpp
mod needs=imgui,overlay,reshade,gearbox_lib,sounds,input_devices :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /LD /Fo:out\obj\gauges.obj /Fe:out\Gauges.asi src\gauges.cpp out\obj\input_devices.obj out\obj\gauge_overlay.obj %IMGUI_OBJ% %SOUNDS% out\obj\gearbox.lib /link user32.lib ole32.lib d3d11.lib d3dcompiler.lib dinput8.lib dxguid.lib

# the settings test: the same source with a main in place of the mod's thread
settings_test needs=gearbox_lib :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /D GAUGES_SETTINGS_TEST /Fo:out\obj\settings_test.obj /Fe:out\test\settings_test.exe src\gauges.cpp out\obj\gearbox.lib /link user32.lib
# the truck test: the reader of the game's memory and the write of engine damage (src\truck.h) against a made up game
truck_test needs=gearbox_lib :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I src /Fo:out\obj\truck_test.obj /Fe:out\test\truck_test.exe test\truck_test.cpp out\obj\gearbox.lib
# the gearbox test: the mod's own gearbox (src\gearbox_model.h) and the hooks' policy, on functions of its own
gearbox_test needs=gearbox_lib :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I src /Fo:out\obj\gearbox_test.obj /Fe:out\test\gearbox_test.exe test\gearbox_test.cpp out\obj\gearbox.lib
# the models test: the engine speed, the range, the tilt, the coolant temperature and what it costs the engine
# (src\models.h) on made up drives, and the sounds of a lifted pedal (src\sound.h)
models_test :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I src /Fo:out\obj\models_test.obj /Fe:out\test\models_test.exe test\models_test.cpp /link ole32.lib
# the input test: the gearbox's bindings (src\input_bindings.h) on made up snapshots, and the wheels and shifters
# this machine has through DirectInput (the mod's own out\obj\input_devices.obj; DirectInput comes with the Windows SDK)
input_test needs=input_devices :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I src /Fo:out\obj\input_test.obj /Fe:out\test\input_test.exe test\input_test.cpp out\obj\input_devices.obj /link user32.lib dinput8.lib dxguid.lib
# the crash line's C runtime handlers (src\crt_line.h): an invalid parameter and abort, each in a child process
crt_test :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I src /Fo:out\obj\crt_test.obj /Fe:out\test\crt_test.exe test\crt_test.cpp
truck_id_test :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I src /Fo:out\obj\truck_id_test.obj /Fe:out\test\truck_id_test.exe test\truck_id_test.cpp
# the late start test: the overlay against a swap chain made before and after its hooks (test\late_test.cpp)
late_test needs=imgui,overlay,reshade :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I deps\imgui /I src /Fo:out\obj\late_test.obj /Fe:out\test\late_test.exe test\late_test.cpp %IMGUI_OBJ% /link d3d11.lib dxgi.lib d3dcompiler.lib ole32.lib user32.lib

# the loader
version_stubs :: ml64 /nologo /c /Fo out\obj\version_stubs.obj tools\version_stubs.asm
loader :: cl /nologo /c /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /Fo:out\obj\loader.obj tools\loader.cpp
version_dll needs=version_stubs,loader :: link /nologo /DLL /DEF:tools\version.def /OUT:out\version.dll /IMPLIB:out\obj\version_proxy.lib out\obj\version_stubs.obj out\obj\loader.obj

# the preview: left out, with a note, where there are no Dear ImGui sources (its exit code 2)
preview ok=2 :: call test\build_preview.bat
