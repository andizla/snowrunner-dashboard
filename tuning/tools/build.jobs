# What build.bat builds, a job a line, for tools\run_jobs.py (its head says how a line reads). build.bat sets
# OVERLAY_OBJ and makes the folders. No two jobs write the same file.

# Dear ImGui (deps\imgui) and its DirectX 11 renderer (src\ng_dx11.cpp) compiled in; ng_overlay.cpp is Next Gen's
# overlay (the Present hook, the NEXT GEN menu), ng_reshade.cpp takes the swap chain from ReShade where it is installed.
# The same files as in the Next Gen mods, compiled as they are: the Gameplay repo's own (..\src and ..\deps).
imgui :: cl /nologo /c /MP /O2 /W3 /EHsc /std:c++17 /utf-8 /MT /I ..\deps\imgui /I ..\deps\stb /Fo:out\obj\ ..\deps\imgui\imgui.cpp ..\deps\imgui\imgui_draw.cpp ..\deps\imgui\imgui_tables.cpp ..\deps\imgui\imgui_widgets.cpp ..\src\ng_dx11.cpp
overlay :: cl /nologo /c /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I ..\deps\imgui /I ..\deps\stb /Fo:out\obj\ng_overlay.obj ..\src\ng_overlay.cpp
reshade :: cl /nologo /c /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I ..\deps\reshade\include /Fo:out\obj\ng_reshade.obj ..\src\ng_reshade.cpp
# the tool
tool needs=imgui,overlay,reshade :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /LD /I ..\deps\imgui /I src /I ..\src /Fo:out\obj\tuning.obj /Fe:out\NextGenTuning.asi src\tuning.cpp %OVERLAY_OBJ% /link user32.lib ole32.lib d3d11.lib d3dcompiler.lib
# the block's test: a mod's side and the tool's side of src\ng_tune.h, and the tab's order and Reset
tune_test :: cl /nologo /O2 /W4 /EHsc /std:c++17 /utf-8 /MT /I ..\deps\imgui /I src /I ..\src /Fo:out\obj\tune_test.obj /Fe:out\test\tune_test.exe test\tune_test.cpp /link user32.lib
